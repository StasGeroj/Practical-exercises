'''Даны целые положительные числа A и B (A > B). На отрезке длины
A размещено максимально возможное количество отрезков длины B (без наложений).
Используя операцию взятия остатка от деления нацело, найти длину незанятой части
отрезка A.'''
 
while True:
    try:

        A = int(input("Введите значение A: "))
        B = int(input("Введите значение B: "))


        if A < 0:

            print("A должно быть больше или равно B. Пожалуйста, введите значение B снова.")


        elif B < 0:
            print("A должно быть положительным числом. Пожалуйста, введите значение A снова.")
 

        elif A < B:
            print("A должно быть положительным числом. Пожалуйста, введите значение B снова.")



        else:
                
            break
        
    except ValueError:
            print("Ошибка: введите целое числов.")
a, b = divmod(A, B)
print (f"{a} {b}")
        
        
        
       
